<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pill"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Visual Thumbnail Preview of Canvas -->
    <ImageView
        android:id="@+id/ivTemplateThumbnail"
        android:layout_width="120dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_bottom_sheet_card"
        android:contentDescription="模版预览"
        android:padding="4dp"
        android:scaleType="fitCenter" />

    <!-- Name and Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTemplateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模版名称"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTemplateTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="内置模版"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Delete Button (Only visible for custom templates) -->
    <ImageButton
        android:id="@+id/btnDeleteTemplate"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="删除模版"
        android:scaleType="centerInside"
        android:src="@drawable/ic_delete"
        app:tint="@color/status_red" />

</LinearLayout>
