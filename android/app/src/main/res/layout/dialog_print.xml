<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打印预览与设置"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Print Preview Thumbnail -->
        <ImageView
            android:id="@+id/ivPrintPreview"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="打印预览"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <!-- Copies Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="打印份数"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMinusCopies"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="－"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCopies"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1 份"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlusCopies"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="＋"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Heating Density -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="热敏浓度 (标准推荐 - 笔画分明)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgDensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checkedButton="@+id/rbDensityNormal"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDensityLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="浅度" />

            <RadioButton
                android:id="@+id/rbDensityNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:textSize="13sp"
                android:text="标准 (推荐)" />

            <RadioButton
                android:id="@+id/rbDensityDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="深度" />
        </RadioGroup>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/printProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvPrintProgressStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:visibility="invisible" />

        <!-- Execute Button -->
        <Button
            android:id="@+id/btnExecutePrint"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_primary"
            android:text="立即打印至得力 Q1A"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
