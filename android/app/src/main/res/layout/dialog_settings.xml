<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card"
    android:orientation="vertical">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/border_color" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:text="打印机与系统设置"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Section 1: Density -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认热敏打印浓度 (推荐标准)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSettingsDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/rbSettingsDensityNormal"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSettingsDensityLight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="浅度" />

                <RadioButton
                    android:id="@+id/rbSettingsDensityNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:textSize="13sp"
                    android:text="标准 (推荐)" />

                <RadioButton
                    android:id="@+id/rbSettingsDensityDark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:text="深度" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/border_subtle" />

            <!-- Section 2: Paper Spec -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标签纸物理耗材规格"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSettingsPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/rbPaper15_30"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbPaper15_30"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    android:text="15 × 30 mm (标准常见标签 - 默认)" />

                <RadioButton
                    android:id="@+id/rbPaper12_40"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    android:text="12 × 40 mm (细长线缆标)" />

                <RadioButton
                    android:id="@+id/rbPaper15_50"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    android:text="15 × 50 mm (加大收纳标)" />

                <RadioButton
                    android:id="@+id/rbPaper15_40"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:textSize="13sp"
                    android:text="15 × 40 mm (长间隙纸)" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/border_subtle" />

            <!-- Section 3: Bluetooth Device -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="蓝牙连接设置"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsDeviceMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="默认绑定打印机: 5E:55:09:F0:A2:1E"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSettingsScan"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="🔍 搜索其他附近的蓝牙打印机"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Pinned Action Bar -->
    <LinearLayout
        android:id="@+id/dialogBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        android:background="@color/bg_card">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_primary"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="保存并应用设置"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
