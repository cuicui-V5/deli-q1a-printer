<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card"
    android:orientation="vertical">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/border_color" />

    <!-- Header with Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="模版库 (可视化预览)"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Save Current Canvas As Template -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveCurrentAsTemplate"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_primary"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/white"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="存当前为模版"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State Hint -->
    <TextView
        android:id="@+id/tvEmptyTemplates"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="暂无模版\n点击右上角【＋ 存当前为模版】\n即可将当前画布保存为专属模版！"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Templates List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTemplates"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />

</LinearLayout>
