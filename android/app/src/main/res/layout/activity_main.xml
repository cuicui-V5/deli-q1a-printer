<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Top App Bar / Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_card"
        android:elevation="3dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo & Title -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="得力 Q1A"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAppTitle"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="设置"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BLE Status Pill -->
        <LinearLayout
            android:id="@+id/bleStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPrint"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="8dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_disconnected" />

            <TextView
                android:id="@+id/tvBleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未连接"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Direct Print Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrint"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_primary"
            android:drawableStart="@drawable/ic_print"
            android:drawableTint="@color/white"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="打印"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sub-bar: Paper Specs & Canvas Tools -->
    <LinearLayout
        android:id="@+id/subBarLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- Paper Spec Selector -->
        <LinearLayout
            android:id="@+id/specContainer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvPaperSpec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15×30 mm (横向)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▼"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Rotate Canvas Button (Vertically centered, no clipping) -->
        <LinearLayout
            android:id="@+id/btnRotateCanvas"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 旋转"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Undo Button -->
        <ImageButton
            android:id="@+id/btnUndo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="撤销"
            android:enabled="false"
            android:src="@android:drawable/ic_menu_revert" />

        <!-- Redo Button -->
        <ImageButton
            android:id="@+id/btnRedo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="重做"
            android:enabled="false"
            android:rotation="180"
            android:src="@android:drawable/ic_menu_revert" />

        <!-- Clear Button -->
        <ImageButton
            android:id="@+id/btnClear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="清空"
            android:src="@android:drawable/ic_menu_delete" />

    </LinearLayout>

    <!-- Center Canvas Workspace -->
    <com.deli.printer.ui.canvas.LabelCanvasView
        android:id="@+id/labelCanvasView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subBarLayout" />

    <!-- Bottom Container: Pinned at bottom of screen -->
    <FrameLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_card"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. Normal State: Main ToolBar (Idle / No selection) -->
        <LinearLayout
            android:id="@+id/mainToolBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="visible">

            <!-- Add Text -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddText"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_primary"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="@color/white"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="添加文本"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Templates -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTemplates"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:drawableStart="@drawable/ic_templates"
                android:drawableTint="@color/text_primary"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="模版库"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Add Barcode / QR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddBarcode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_secondary"
                android:drawableStart="@drawable/ic_qr_code"
                android:drawableTint="@color/text_primary"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:text="条码/QR"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 2. Text Selected State: Half-Screen Bottom Property Sheet -->
        <LinearLayout
            android:id="@+id/textInspectorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文本属性设置"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Done Button (Proper height & vertically centered) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnInspectorDone"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_primary"
                    android:drawableStart="@drawable/ic_check"
                    android:drawableTint="@color/white"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="完成"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Direct Text Input (Instant real-time typing) -->
            <EditText
                android:id="@+id/etInspectorText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="在此直接编辑文本内容..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <!-- Font Size Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字号"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="A"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/sbInspectorTextSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="28"
                    android:progress="14" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="A"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInspectorSizeValue"
                    android:layout_width="48dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:text="22 pt"
                    android:textColor="@color/brand_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Styles & Alignment (Pure Material Icons - No text truncation!) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Bold Toggle Icon Button -->
                <ImageButton
                    android:id="@+id/btnInspectorBold"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="粗体"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_format_bold"
                    app:tint="@color/text_primary" />

                <!-- Align Left Icon Button -->
                <ImageButton
                    android:id="@+id/btnInspectorAlignLeft"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="靠左对齐"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_format_align_left"
                    app:tint="@color/text_primary" />

                <!-- Align Center Icon Button -->
                <ImageButton
                    android:id="@+id/btnInspectorAlignCenter"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:contentDescription="居中对齐"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_format_align_center"
                    app:tint="@color/text_primary" />

                <!-- Delete Icon Button -->
                <ImageButton
                    android:id="@+id/btnInspectorDelete"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_danger_subtle"
                    android:contentDescription="删除文本"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/status_red" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
